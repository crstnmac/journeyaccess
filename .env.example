# --- Jev (TypeSafe) ---
# live = call the real Jev API. mock = deterministic local judgments (tests / offline demos).
JEV_MODE=live

# TypeSafe Jev API key. Required for JEV_MODE=live.
JEV_API_KEY=

# Override only if TypeSafe changes the endpoint.
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Browser channel used by Playwright. "chrome" uses an installed Google Chrome,
# leave empty to use the Playwright-bundled Chromium (`pnpm exec playwright install chromium`).
PLAYWRIGHT_CHANNEL=chrome

# Base URL used to rewrite localhost demo URLs when the app runs on a different port.
# DEMO_BASE_URL=http://localhost:3000
